# Security and cache headers for the app files (the same set that vercel.json used to send).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://salesiq.zohopublic.com https://*.zohopublic.com https://*.zohostatic.com; frame-src https://challenges.cloudflare.com https://*.zohopublic.com; style-src 'self' 'unsafe-inline' https://*.zohopublic.com https://*.zohostatic.com; font-src 'self' https://*.zohostatic.com https://*.zohopublic.com; img-src 'self' data: blob: https://*.zohopublic.com https://*.zohostatic.com https://*.zoho.com; media-src 'self' blob: data:; connect-src 'self' https://challenges.cloudflare.com https://*.zohopublic.com wss://*.zohopublic.com; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), payment=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
/ngsw-worker.js
  Cache-Control: no-cache
/ngsw.json
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
